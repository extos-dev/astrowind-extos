---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'About',
  description:
    'ExtOS.win is an independent studio building local-first Chrome extensions: small tools, minimal permissions, no accounts, no tracking.',
};
---

<Layout metadata={metadata}>
  <HeroText
    badge="Independent studio"
    tagline="About"
    title="Small browser tools, built to be audited."
    subtitle="ExtOS.win is an independent software studio. We build Chrome extensions that do one job, ask for the permission that job needs, and process your data on your machine."
    callToAction={{ text: 'See the extensions', href: getPermalink('/extensions'), icon: 'tabler:puzzle' }}
    callToAction2={{ text: 'Talk to us', href: getPermalink('/contact'), icon: 'tabler:mail' }}
  />

  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-12 md:py-16" aria-labelledby="story">
    <div class="prose prose-lg dark:prose-invert mx-auto">
      <h2 id="story">Why these extensions exist</h2>
      <p>
        Browser extensions have a trust problem. The useful ones ask for access to every page you visit, the polished
        ones want an account, and the free ones sometimes pay for themselves with your browsing data. The category is
        full of tools that are hard to audit and easy to forget about.
      </p>
      <p>
        ExtOS.win is an attempt to build the opposite: small extensions with a visible job, a short permission list, and
        a clear answer to “what leaves my device?”. Three are in the pipeline — one extracts structured data from a
        page, one reads invoices without uploading them, one audits the extensions you already have installed.
      </p>
      <p>
        None of them has a public Chrome Web Store listing yet. We would rather show you exactly what each one does and
        what it asks for before there is an install button.
      </p>
    </div>
  </section>

  <Features
    id="principles"
    tagline="The rules"
    title="What we optimise for"
    columns={2}
    items={[
      {
        title: 'Auditability over polish',
        description:
          'A permission list you can read and a data flow you can explain beat a feature list you cannot verify. Every product page is written to be checked, not skimmed.',
        icon: 'tabler:search',
      },
      {
        title: 'One problem per product',
        description:
          'Feature creep is how extensions end up asking for everything. Each tool stays narrow enough that its permission set can stay narrow too.',
        icon: 'tabler:focus-2',
      },
      {
        title: 'No dark patterns',
        description:
          'No fake countdowns, no invented install numbers, no “free” tier that quietly uploads your data. If something is pre-release, the page says so.',
        icon: 'tabler:eye-off',
      },
      {
        title: 'Boring, current engineering',
        description:
          'Manifest V3, the side panel API, service workers that idle, and exports in formats other software can open. No proprietary lock-in for your own data.',
        icon: 'tabler:tool',
      },
    ]}
  />

  <section class="max-w-3xl mx-auto px-4 sm:px-6 pb-16 md:pb-24" aria-labelledby="process">
    <div class="prose prose-lg dark:prose-invert mx-auto">
      <h2 id="process">How a release works</h2>
      <ol>
        <li><strong>Build the narrow version.</strong> One workflow, no accounts, local processing.</li>
        <li><strong>Test it against real pages and real files.</strong> Not a demo dataset.</li>
        <li><strong>Write down the permissions and the network calls</strong> before the listing exists.</li>
        <li><strong>Submit to the Chrome Web Store.</strong> Nothing is distributed outside the store.</li>
      </ol>
      <p>
        If an extension fails at step three — because a feature needs more access than the job is worth — it does not
        ship.
      </p>
    </div>
  </section>

  <CallToAction
    actions={[
      { variant: 'primary', text: 'See the portfolio', href: getPermalink('/extensions'), icon: 'tabler:puzzle' },
      { text: 'Ask about early access', href: getPermalink('/contact'), icon: 'tabler:mail' },
    ]}
  >
    <Fragment slot="title">Building something in this space too?</Fragment>
    <Fragment slot="subtitle">
      We are happy to compare notes on Manifest V3, local processing, or what a permission actually costs a user.
    </Fragment>
  </CallToAction>
</Layout>
