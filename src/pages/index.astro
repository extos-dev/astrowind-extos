---
import Layout from '~/layouts/PageLayout.astro';

import HeroText from '~/components/widgets/HeroText.astro';
import SocialProof from '~/components/widgets/SocialProof.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Features from '~/components/widgets/Features.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

import { products, availabilityLabel } from '~/data/products';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'ExtOS.win — Local-first Chrome extensions',
  description:
    'Small, focused Chrome extensions that process your data on your machine: extract page data, read invoices, audit installed extensions. Manifest V3, minimal permissions, no accounts.',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'ExtOS extensions',
    itemListElement: products.map((product, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: product.name,
      url: new URL(getPermalink(`/extensions/${product.slug}`), SITE?.site).toString(),
    })),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- Hero ************************** -->

  <HeroText
    badge="Manifest V3 · Local-first"
    tagline="ExtOS.win"
    title="Chrome extensions that keep your data on your machine."
    subtitle="Small, focused tools for the browser: extract a table, read an invoice, audit what your extensions can do. The work happens on your device, the permissions stay minimal, and nothing is uploaded."
    callToAction={{ text: 'See the extensions', href: '#extensions', icon: 'tabler:arrow-down' }}
    callToAction2={{ text: 'How we build', href: '#principles', icon: 'tabler:code' }}
  />

  <!-- Honest facts strip ************ -->

  <SocialProof
    id="facts"
    classes={{ container: '!pb-12 md:!pb-16' }}
    items={[
      { value: '3', label: 'Extensions built', icon: 'tabler:puzzle', color: 'text-primary' },
      { value: 'MV3', label: 'Manifest V3 only', icon: 'tabler:shield-check', color: 'text-emerald-500' },
      { value: 'Local', label: 'Processing model', icon: 'tabler:device-laptop', color: 'text-sky-500' },
      { value: '0', label: 'Trackers on this site', icon: 'tabler:eye-off', color: 'text-violet-500' },
    ]}
  />

  <!-- Extensions ******************** -->

  <Features2
    id="extensions"
    tagline="The extensions"
    title="Three tools, one job each"
    subtitle="Everything below is pre-release. Each page explains what the extension does, which permissions it asks for, and what leaves your device — before you install anything."
    columns={3}
    items={products.map((product) => ({
      title: product.name,
      description: `${product.summary}<br /><span class="mt-3 inline-block rounded-full border border-gray-300 px-2.5 py-0.5 text-xs font-semibold text-gray-700 dark:border-slate-600 dark:text-slate-300">${availabilityLabel(product)}</span>`,
      icon: product.icon,
      href: getPermalink(`/extensions/${product.slug}`),
    }))}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Principles ******************** -->

  <Features
    id="principles"
    tagline="How we build"
    title="Boring choices, on purpose"
    subtitle="The rules we do not bend when shipping an extension."
    items={[
      {
        title: 'Local-first',
        description:
          'If a job can run in the browser, it runs in the browser. When a product needs the network, its page says exactly what is sent and why.',
        icon: 'tabler:device-laptop',
      },
      {
        title: 'Minimal permissions',
        description:
          'Every permission is listed with the reason it exists. No broad host access unless the core feature cannot work without it.',
        icon: 'tabler:key',
      },
      {
        title: 'One job per extension',
        description:
          'No tab manager bundled with a VPN. Small tools are easier to audit, cheaper to run, and easier to replace when you stop needing them.',
        icon: 'tabler:box',
      },
      {
        title: 'No accounts',
        description:
          'There is nothing to sign up for. Settings and working data live in Chrome storage on your device.',
        icon: 'tabler:user-off',
      },
      {
        title: 'No tracking',
        description:
          'This site serves static pages with no analytics and no cookies. The extensions do not ship telemetry SDKs.',
        icon: 'tabler:eye-off',
      },
      {
        title: 'Current platform',
        description:
          'Manifest V3, service workers that sleep when idle, and no deprecated APIs kept alive with workarounds.',
        icon: 'tabler:brand-chrome',
      },
    ]}
  />

  <!-- Local-first explainer ********* -->

  <section class="max-w-3xl mx-auto px-4 sm:px-6 pb-16 md:pb-24" aria-labelledby="local-first">
    <div class="prose prose-lg dark:prose-invert mx-auto">
      <h2 id="local-first">What “local-first” actually means here</h2>
      <p>
        It is easy to print a lock icon on a landing page. These are the specific promises behind ours, and they apply
        to every extension on this site:
      </p>
      <ul>
        <li>
          <strong>Your content is not uploaded.</strong> Page captures, invoices and extension inventories are processed in
          the browser and written to a local file or Chrome storage.
        </li>
        <li>
          <strong>Network calls are named.</strong> If an extension talks to a server, its product page says which server,
          what is sent, and what happens when the call fails.
        </li>
        <li>
          <strong>No account, no profile.</strong> There is no sign-in, no user ID and no cross-device analytics profile.
        </li>
        <li>
          <strong>Uninstalling removes the data.</strong> Chrome deletes extension storage when you remove the extension;
          exported files stay wherever you saved them.
        </li>
      </ul>
    </div>
  </section>

  <!-- FAQs ************************** -->

  <FAQs
    id="faqs"
    tagline="FAQs"
    title="Questions worth asking before you install anything"
    subtitle="Short answers. The product pages carry the detail."
    schema
    items={[
      {
        title: 'Can I install these extensions today?',
        description:
          'Not yet. All three are pre-release and none has a public Chrome Web Store listing. The product pages describe what each one does and which permissions it requests, so you can decide before launch.',
      },
      {
        title: 'Do you collect my data?',
        description:
          'No. This website is a set of static pages: no analytics, no cookies, no accounts. The extensions process data on your device, and each product page names the only outbound requests it makes.',
      },
      {
        title: 'Why does an extension need access to websites?',
        description:
          'Because reading the page is the feature. TabWize reads a page only when you start a capture; it does not run in the background collecting browsing history. The exact access is listed per product.',
      },
      {
        title: 'What does it cost?',
        description:
          'Nothing is charged today. Pricing for each extension will be published on its product page and in the Chrome Web Store listing before it becomes available.',
      },
      {
        title: 'Which version of Chrome do I need?',
        description: 'Chrome 116 or newer. All three extensions are Manifest V3 and use the side panel API.',
      },
      {
        title: 'How do updates work?',
        description:
          'Once an extension is installed from the Chrome Web Store, Chrome updates it automatically. Pre-release builds are loaded unpacked during testing and are not distributed.',
      },
    ]}
  />

  <!-- Call to action **************** -->

  <CallToAction
    actions={[
      { variant: 'primary', text: 'Talk to us', href: getPermalink('/contact'), icon: 'tabler:mail' },
      { text: 'Read the privacy policy', href: getPermalink('/privacy'), icon: 'tabler:lock' },
    ]}
  >
    <Fragment slot="title">Want to know when the first extension ships?</Fragment>
    <Fragment slot="subtitle">
      Tell us which of the three you would use first. That decides what we finish next.
    </Fragment>
  </CallToAction>
</Layout>
