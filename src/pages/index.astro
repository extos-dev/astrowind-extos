---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import BlogHighlightedPosts from '~/components/widgets/BlogHighlightedPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import SocialProof from '~/components/widgets/SocialProof.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE, METADATA, I18N } from 'astrowind:config';
import favIconSvg from '~/assets/favicons/favicon.svg';

const metadata = {
  title: 'ExtOS.win — Powerful Chrome Extensions for Productivity & Web Enhancement',
  ignoreTitleTemplate: true,
};

const organizationId = `${SITE?.site}/#organization`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: SITE?.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
    publisher: { '@id': organizationId },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': organizationId,
    name: SITE?.name,
    url: SITE?.site,
    logo: new URL(favIconSvg.src, SITE?.site).toString(),
    ...(METADATA?.twitter?.handle ? { sameAs: [`https://x.com/${METADATA.twitter.handle.replace(/^@/, '')}`] } : {}),
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Chrome Extension OS Suite"
    actions={[
      {
        variant: 'primary',
        text: 'Explore Extensions',
        href: '#extensions',
        icon: 'tabler:arrow-down',
      },
      {
        text: 'Chrome Web Store',
        href: 'https://chromewebstore.google.com',
        target: '_blank',
        icon: 'tabler:brand-chrome',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&w=2070&q=80',
      alt: 'ExtOS Modern Interface Preview',
    }}
  >
    <Fragment slot="title">
      Supercharge Your Browser with <span class="text-accent dark:text-white">ExtOS.win</span>
    </Fragment>

    <Fragment slot="subtitle">
      A modern suite of lightweight, secure, and intuitive Chrome extensions designed to upgrade your daily web
      workflow. Built on Manifest V3 with a strict zero-tracking privacy policy.
    </Fragment>
  </Hero>

  <!-- SocialProof Widget ************ -->

  <SocialProof
    id="proof"
    classes={{ container: '!pb-12 md:!pb-16' }}
    items={[
      {
        value: '100% Free',
        label: 'Open & Accessible',
        icon: 'tabler:sparkles',
        color: 'text-amber-400',
      },
      { value: 'Manifest V3', label: 'Latest Chrome Standard', icon: 'tabler:shield-check', color: 'text-emerald-500' },
      { value: '0 Data Collected', label: 'Privacy First Architecture', icon: 'tabler:lock', color: 'text-sky-500' },
    ]}
  />

  <!-- Extensions Section (Features2) ************** -->

  <Features2
    id="extensions"
    title="Featured Extensions"
    subtitle="Engineered for performance, minimalism, and focus. Designed to seamlessly enhance your browser."
    tagline="ExtOS Apps"
    items={[
      {
        title: 'Tab OS',
        description:
          'Instant tab search, group management, and automatic memory cleanup to keep your browser fast and responsive.',
        icon: 'tabler:browser',
      },
      {
        title: 'Clip OS',
        description:
          'One-click web clipper & markdown organizer. Save snippets, images, and full articles straight to your workspace.',
        icon: 'tabler:scissors',
      },
      {
        title: 'Prompt OS',
        description: 'Quick-access AI prompt manager integrated directly into every input field across the web.',
        icon: 'tabler:sparkles',
      },
      {
        title: 'Focus OS',
        description:
          'Distraction blocker with built-in Pomodoro timer and customizable web filters for maximum productivity.',
        icon: 'tabler:target',
      },
      {
        title: 'Dark Mode Pro',
        description:
          'Instant, eye-friendly dark mode for every website with custom contrast controls and schedule automation.',
        icon: 'tabler:moon',
      },
      {
        title: 'Dev OS',
        description:
          'Essential browser toolbar for web developers: JSON viewer, visual inspect, CSS grid overlays, and cookie management.',
        icon: 'tabler:code',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Key Features Widget *************** -->

  <Features
    id="features"
    tagline="Why ExtOS?"
    title="Designed for Modern Web Power Users"
    subtitle="We build browser extensions the right way — fast, clean, and completely private."
    items={[
      {
        title: 'Manifest V3 Compliant',
        description:
          'Fully upgraded to Google Chrome’s latest extension architecture ensuring high performance, security, and long-term stability.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Zero Background Lag',
        description:
          'Designed with lightweight service workers that sleep when inactive, using minimal CPU and system RAM.',
        icon: 'tabler:bolt',
      },
      {
        title: 'Privacy-First & No Tracking',
        description:
          'Your data stays on your machine. We do not sell data, track browsing history, or send personal information to external servers.',
        icon: 'tabler:lock',
      },
      {
        title: 'Keyboard First Shortcuts',
        description:
          'Blazing fast keybindings for every command. Execute actions instantly without taking your hands off the keyboard.',
        icon: 'tabler:keyboard',
      },
      {
        title: 'Native Dark & Light Mode',
        description: 'Beautifully crafted interface that automatically syncs with your system theme preferences.',
        icon: 'tabler:palette',
      },
      {
        title: 'Seamless Synchronization',
        description:
          'Optionally sync preferences and settings securely across all your Chrome devices via Chrome Sync API.',
        icon: 'tabler:refresh',
      },
    ]}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="Start enhancing your browser in under a minute"
    items={[
      {
        title: 'Step 1: <span class="font-medium">Browse Extensions</span>',
        description:
          'Select from the ExtOS catalog according to your workflow needs — tab management, clipping, AI prompts, or developer tools.',
        icon: 'tabler:search',
      },
      {
        title: 'Step 2: <span class="font-medium">Add to Chrome</span>',
        description: 'One-click installation directly from the official Chrome Web Store with instant verification.',
        icon: 'tabler:brand-chrome',
      },
      {
        title: 'Step 3: <span class="font-medium">Customize & Enjoy</span>',
        description:
          'Set up your custom shortcuts and options. Enjoy a faster, cleaner, and more productive web browsing experience.',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1531403009284-440f080d1e12?auto=format&fit=crop&w=1000&q=80',
      alt: 'Browser productivity setup illustration',
    }}
  />

  <!-- Note Widget ******************* -->

  <Note
    title="Our Promise:"
    description="100% Privacy Preserved. Minimal Resource Footprint. Uncompromising Performance."
  />

  <!-- HighlightedPosts Widget ******* -->

  <BlogHighlightedPosts
    title="Extension Updates & Power User Guides"
    postIds={[
      'build-websites-with-ai',
      'get-started-website-with-astro-tailwind-css',
      'astrowind-template-in-depth',
      'useful-resources-to-create-websites',
    ]}
    information={`Explore our latest guides, changelogs, and browser extension productivity tips. Learn how to get the most out of your web workflow with ExtOS.`}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    id="faqs"
    title="Frequently Asked Questions"
    subtitle="Everything you need to know about ExtOS Chrome extensions and security."
    tagline="FAQs"
    schema
    items={[
      {
        title: 'Are ExtOS extensions safe to install?',
        description:
          'Yes, absolutely. All ExtOS extensions undergo strict security reviews by the Google Chrome Web Store team and strictly follow Manifest V3 security guidelines.',
      },
      {
        title: 'Do you collect or track my personal browsing data?',
        description:
          'No. ExtOS is built on a strict privacy-first architecture. All settings and data are stored locally on your device or via secure Chrome Storage API. Zero telemetry or user tracking.',
      },
      {
        title: 'Are ExtOS Chrome extensions free to use?',
        description:
          'Yes! All core tools in the ExtOS extension suite are free to install and use without hidden paywalls.',
      },
      {
        title: 'Will these extensions slow down my Chrome browser?',
        description:
          'No. ExtOS extensions are engineered to be lightweight with minimal background activity, ensuring your browser remains quick and responsive.',
      },
      {
        title: 'How do automatic updates work?',
        description:
          'Chrome automatically keeps your installed extensions up to date as soon as new releases are published to the Chrome Web Store.',
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    id="stats"
    countUp
    stats={[
      { title: 'Active Installs', amount: '25K+' },
      { title: 'Chrome Store Rating', amount: '4.9 ★' },
      { title: 'Data Collected', amount: '0 KB' },
      { title: 'Manifest V3', amount: '100%' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Explore Chrome Web Store',
        href: 'https://chromewebstore.google.com',
        target: '_blank',
        icon: 'tabler:brand-chrome',
      },
    ]}
  >
    <Fragment slot="title">
      Ready to Upgrade Your <br class="block sm:hidden" /><span class="sm:whitespace-nowrap">Chrome Experience?</span>
    </Fragment>

    <Fragment slot="subtitle">
      Install ExtOS extensions today and discover a cleaner, faster, and more efficient way to browse the web.
    </Fragment>
  </CallToAction>
</Layout>
